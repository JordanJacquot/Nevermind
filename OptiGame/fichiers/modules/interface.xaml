                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                  <StackPanel x:Name="NetHero" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Ton réseau"/>
                    <StackPanel x:Name="NetScanInfo" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="BtnNetAuditView" Style="{StaticResource BtnSecondary}" Content="Voir le rapport" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnNetAudit" Style="{StaticResource BtnPrimary}" Content="Lancer l'audit"/>
                  </StackPanel>
                  <Border x:Name="NetAuditScoreBox" Width="56" Height="56" CornerRadius="28" BorderThickness="3" BorderBrush="#343C4C" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NetAuditScore" Text="?" Foreground="#9AA3B2" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" Text="Audit de sécurité"/>
                    <TextBlock x:Name="NetAuditText" Foreground="#9AA3B2" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <DockPanel Margin="0,24,0,12">
                <TextBlock x:Name="NetDevSummary" DockPanel.Dock="Right" Foreground="#9AA3B2" FontSize="12" VerticalAlignment="Bottom"/>
                <TextBlock Style="{StaticResource H2}" FontSize="19" Text="Appareils connectés"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="ChkNetWatch" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                <TextBlock Text="Me prévenir quand un nouvel appareil se connecte (vérifié toutes les 10 minutes, tant qu'OptiGame est ouvert)" Foreground="#9AA3B2" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <WrapPanel x:Name="NetDevFilters" Margin="0,0,0,12"/>
              <UniformGrid x:Name="NetDevices" Columns="3"/>
              <TextBlock x:Name="NetDevHint" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,0" Text="Clique sur « Scanner le réseau » pour voir les appareils connectés."/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Trafic : ce qui sort du PC -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="0,2,12,0"/>
            <TextBlock Text="Trafic"/>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <Button x:Name="BtnTraffic" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Démarrer la surveillance" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Ce qui sort de ton PC"/>
              <TextBlock Style="{StaticResource Sub}" Text="Quels programmes communiquent avec Internet, avec qui, combien ils envoient, et ce qui est anormal."/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TrafficPanel" Margin="0,0,8,0"/>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#B30F1218" BorderBrush="#1F2531" BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock x:Name="StatusText" Text="Prêt." Foreground="#9AA3B2" FontSize="12"/>
    </Border>

    <!-- Fiche détaillée d'un point à corriger -->
    <Grid x:Name="Overlay" Grid.RowSpan="3" Visibility="Collapsed">
      <Border x:Name="OverlayBackdrop" Background="#D0080A0D"/>
      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16"
              Width="640" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
        <Grid Margin="28,24,28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel x:Name="SheetBody"/>
          </ScrollViewer>
          <DockPanel Grid.Row="1" Margin="0,22,0,0" LastChildFill="False">
            <Button x:Name="SheetIgnore" DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Content="Ignorer ce point"/>
            <Button x:Name="SheetRun" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Exécuter" Margin="10,0,0,0"/>
            <Button x:Name="SheetOpen" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Ouvrir" Margin="10,0,0,0"/>
            <Button x:Name="SheetClose" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Fermer"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Carte du réseau (sous le panneau des tests : la fiche d'un appareil s'ouvre par dessus) -->
    <Grid x:Name="NetMapOverlay" Grid.RowSpan="3" Visibility="Collapsed">
      <Border Background="#E6080A0D"/>
      <Border Background="#F2101319" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="18" Margin="24">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
        <Grid Margin="26,20,26,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <Button x:Name="BtnNetMapClose" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Fermer" VerticalAlignment="Center"/>
            <Button x:Name="BtnNetMapScan" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Rescanner" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="Carte de ton réseau" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF"/>
              <TextBlock x:Name="NetMapSub" FontSize="12.5" Foreground="#9AA3B2" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,8,0,8">
            <Canvas x:Name="NetMapCanvas" Width="1200" Height="780"/>
          </Viewbox>
          <WrapPanel x:Name="NetMapLegend" Grid.Row="2" HorizontalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Panneau des tests -->
    <Grid x:Name="TestOverlay" Grid.RowSpan="3" Visibility="Collapsed">
      <Border x:Name="TestBackdrop" Background="#D0080A0D"/>
      <Border x:Name="TestCard" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="18"
              Width="760" Margin="24,16" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
        <Border.RenderTransform><ScaleTransform x:Name="TestCardScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Grid Margin="26,22,26,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <Button x:Name="BtnTestX" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="✕" Padding="12,6" VerticalAlignment="Top"/>
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Background="#1A2A40" Margin="0,0,14,0">
              <TextBlock x:Name="TestTag" Foreground="#4EA8FF" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="TestTitle" Foreground="White" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock x:Name="TestSub" Foreground="#9AA3B2" FontSize="12.5" VerticalAlignment="Center"/>
                <Ellipse x:Name="TestStateDot" Width="8" Height="8" Margin="14,0,6,0" VerticalAlignment="Center" Fill="#4EA8FF"/>
                <TextBlock x:Name="TestStateText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="TestProgress" Height="5" VerticalAlignment="Center"/>
            <TextBlock x:Name="TestPct" Grid.Column="1" Foreground="#9AA3B2" FontSize="12" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
          </Grid>
          <ScrollViewer x:Name="TestScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="450">
            <StackPanel x:Name="TestBody" Margin="0,0,12,0"/>
          </ScrollViewer>
          <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="BtnTestStop" DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Content="Arrêter le test"/>
            <Button x:Name="BtnTestClose" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Fermer"/>
            <Button x:Name="BtnTestAgain" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Refaire le test" Margin="0,0,10,0"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Chargement au démarrage : cache l'app tant que les premières tâches ne sont pas finies -->
    <Grid x:Name="StartupOverlay" Grid.RowSpan="3">
      <Grid.Background>
        <RadialGradientBrush x:Name="StartupHalo" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.85" RadiusY="0.95">
          <GradientStop Color="#132A1F" Offset="0"/>
          <GradientStop Color="#0B0D12" Offset="1"/>
        </RadialGradientBrush>
      </Grid.Background>
      <StackPanel x:Name="StartupContent" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform><ScaleTransform x:Name="StartupZoom" ScaleX="1" ScaleY="1"/></StackPanel.RenderTransform>
        <Grid x:Name="StartupLoaderHost" Width="260" Height="260" Margin="0,0,0,6"/>
        <TextBlock Text="OptiGame" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FFFFFF" Offset="0.2"/>
              <GradientStop Color="#5CF0AA" Offset="1"/>
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
        <TextBlock x:Name="StartupStep" Text="Préparation..." FontSize="14.5" FontWeight="SemiBold" Foreground="#C9CED8" HorizontalAlignment="Center" Margin="0,10,0,0">
          <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="StartupDetail" FontSize="11.5" Foreground="#5B6475" HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
